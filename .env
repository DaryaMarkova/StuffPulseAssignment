# Host ports (mapped from containers)
CLIENT_PORT=8080
SERVER_PORT=3001

# Server runtime
MUTATION_INTERVAL_MS=4000

# Frontend build (relative /api is proxied by nginx to the server service)
VITE_API_BASE=/api
# true = always use public/data/nodes.json (GitHub Pages / offline demo)
VITE_USE_STATIC_DATA=false

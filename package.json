{
  "name": "stuffpulseassignment",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix server",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:server\" \"npm run dev\"",
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "build": "tsc -b && vite build",
    "build:size": "npm run build && node scripts/check-gzip-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.103.0",
    "material-design-lite": "^1.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
